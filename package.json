  "engines": {
    "node": "24.14.0",
    "next": "16.2.0"
  },
  "author": "",
  "type": "commonjs",
  "main": "darken.js",
  "scripts": {
    "sync": "node fetch_data.js",
    "parse": "node parse_items.js",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:auth\"",
    "dev:web": "cd web && npm run dev",
    "dev:auth": "cd auth-server && npm start",
    "build": "cd web && npm run build",
    "start": "cd web && npm run start",
    "refresh": "node fetch_data.js && node parse_items.js",
    "install:all": "npm install && cd web && npm install && cd ../auth-server && npm install"
  },
  "dependencies": {
    "csv-parse": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "next": "16.2.0"
  }
